@page "/jobs"
@using CarMechanicWorkshop.Shared.Models.DTOs
@using CarMechanicWorkshop.Shared.Models
@inject HttpClient Http
@inject IJSRuntime JS

<h3 class="mb-4">Job Management</h3>

@if (isLoading)
{
    <p>Loading jobs...</p>
}
else if (jobs == null || !jobs.Any())
{
    <div class="alert alert-info">No jobs found.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Client</th>
                <th>License Plate</th>
                <th>Year</th>
                <th>Category</th>
                <th>Severity</th>
                <th>Status</th>
                <th>Est. Hours</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in jobs)
            {
                <tr>
                    <td>@job.Id</td>
                    <td>@job.ClientName</td>
                    <td>@job.LicensePlate</td>
                    <td>@job.ManufacturingYear</td>
                    <td>@job.Category</td>
                    <td>@job.Severity</td>
                    <td>
                        <span class="badge bg-@GetStatusColor(job.Status)">
                            @job.Status
                        </span>
                    </td>
                    <td>@job.EstimatedHours.ToString("0.0")</td>
                    <td>@job.Description</td>
                </tr>
            }
        </tbody>
    </table>
}

<hr />

<h5 class="mt-4">Add New Job</h5>

<EditForm Model="newJob" OnValidSubmit="CreateJobAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row mb-3">
        <div class="col-md-4">
            <label>Client ID:</label>
            <InputNumber @bind-Value="newJob.ClientId" class="form-control" />
        </div>
        <div class="col-md-4">
            <label>License Plate:</label>
            <InputText @bind-Value="newJob.LicensePlate" class="form-control" />
        </div>
        <div class="col-md-4">
            <label>Manufacturing Year:</label>
            <InputNumber @bind-Value="newJob.ManufacturingYear" class="form-control" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label>Category:</label>
            <InputSelect @bind-Value="newJob.Category" class="form-select">
                @foreach (var cat in Enum.GetValues<JobCategoryEnum>())
                {
                    <option value="@cat">@cat</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-4">
            <label>Severity:</label>
            <InputNumber @bind-Value="newJob.Severity" class="form-control" />
        </div>
        <div class="col-md-4">
            <label>Status:</label>
            <InputSelect @bind-Value="newJob.Status" class="form-select">
                @foreach (var s in Enum.GetValues<JobStatusEnum>())
                {
                    <option value="@s">@s</option>
                }
            </InputSelect>
        </div>
    </div>

    <div class="mb-3">
        <label>Description:</label>
        <InputTextArea @bind-Value="newJob.Description" class="form-control" rows="3" />
    </div>

    <button class="btn btn-primary" type="submit" disabled="@isSubmitting">
        @(isSubmitting ? "Submitting..." : "Create Job")
    </button>
</EditForm>

@code {
    private List<JobDTO>? jobs;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private CreateJobDTO newJob = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadJobsAsync();
    }

    private async Task LoadJobsAsync()
    {
        try
        {
            isLoading = true;
            jobs = await Http.GetFromJsonAsync<List<JobDTO>>("jobs");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading jobs: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Failed to load jobs.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateJobAsync()
    {
        try
        {
            isSubmitting = true;
            var response = await Http.PostAsJsonAsync("jobs", newJob);

            if (response.IsSuccessStatusCode)
            {
                await LoadJobsAsync();
                newJob = new();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await JS.InvokeVoidAsync("alert", $"Error creating job: {error}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Exception: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static string GetStatusColor(JobStatusEnum status) => status switch
    {
        JobStatusEnum.Accepted => "info",
        JobStatusEnum.InProgress => "warning",
        JobStatusEnum.Completed => "success",
        @* JobStatusEnum.Cancelled => "danger", *@
        _ => "secondary"
    };
}
