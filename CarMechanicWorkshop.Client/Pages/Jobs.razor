@page "/jobs"
@using CarMechanicWorkshop.Client.Services
@using CarMechanicWorkshop.Shared.Models
@using CarMechanicWorkshop.Shared.Models.DTOs
@using CarMechanicWorkshop.Shared.Models.Database
@using System.Runtime.InteropServices
@inject JobsApiService JobsService
@inject ClientsApiService ClientsService
@inject IJSRuntime JS

<h3 class="mb-3">Munkák</h3>

<div class="mb-3 row">
    <div class="col-md-4">
        <label>Filter by client</label>
        <InputSelect @bind-Value="selectedClientId" class="form-select" @onchange="ClientFilterChanged">
            <option value="0">-- All clients --</option>
            @if (clients != null)
            {
                @foreach (var c in clients)
                {
                    <option value="@c.Id">@c.Name (@c.Id)</option>
                }
            }
        </InputSelect>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <button class="btn btn-primary me-2" @onclick="LoadJobsAsync">Refresh</button>
        <button class="btn btn-success" @onclick="ShowAddForm">Create new job</button>
    </div>
</div>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (jobs == null || !jobs.Any())
{
    <div class="alert alert-info">There are no jobs available.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Client</th>
                <th>License Plate</th>
                <th>Manufacturing Year</th>
                <th>Category</th>
                <th>Severity</th>
                <th>Status</th>
                <th>Working hours (EstimatedHours)</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in jobs)
            {
                <tr>
                    <td>@job.Id</td>
                    <td>@job.ClientName (@job.ClientId)</td>
                    <td>@job.LicensePlate</td>
                    <td>@job.ManufacturingYear</td>
                    <td>@job.Category</td>
                    <td>@job.Severity</td>
                    <td>
                        <span class="badge bg-@GetStatusColor(job.Status)">
                            @job.Status
                        </span>
                    </td>
                    <td>@job.EstimatedHours.ToString("0.0")</td>
                    <td>@job.Description</td>
                    <td>
                        <button class="btn btn-sm btn-warning me-1" @onclick="() => OpenEdit(job)">Update</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteJobAsync(job.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (isAddVisible)
{
    <h5 class="mt-4">Create new job</h5>
    <EditForm Model="createModel" OnValidSubmit="CreateJobAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="row mb-2">
            <div class="col-md-4">
                <label>Client</label>
                <InputSelect @bind-Value="createModel.ClientId" class="form-select">
                    <option value="0">-- Choose client --</option>
                    @foreach (var c in clients ?? Enumerable.Empty<ClientDTO>())
                    {
                        <option value="@c.Id">@c.Name (@c.Id)</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-4">
                <label>License Plate</label>
                <InputText @bind-Value="createModel.LicensePlate" class="form-control" />
            </div>
            <div class="col-md-4">
                <label>Manufacturing Year</label>
                <InputNumber @bind-Value="createModel.ManufacturingYear" class="form-control" min="1900" />
                <div class="form-text">Year >= 1900</div>
            </div>
        </div>

        <div class="row mb-2">
            <div class="col-md-4">
                <label>Category</label>
                <InputSelect @bind-Value="createModel.Category" class="form-select">
                    @foreach (var cat in Enum.GetValues<JobCategoryEnum>())
                    {
                        <option value="@cat">@cat</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-4">
                <label>Severity (1-10)</label>
                <InputNumber @bind-Value="createModel.Severity" class="form-control" min="1" max="10" />
            </div>
            <div class="col-md-4">
                <label>Status</label>
                <InputSelect @bind-Value="createModel.Status" class="form-select" disabled>
                    @foreach (var s in Enum.GetValues<JobStatusEnum>())
                    {
                        <option value="@s">@s</option>
                    }
                </InputSelect>
                <div class="form-text">Initial status for new jobs: Accepted</div>
            </div>
        </div>

        <div class="mb-2">
            <label>Description</label>
            <InputTextArea @bind-Value="createModel.Description" class="form-control" rows="3" />
        </div>

        <button class="btn btn-primary me-2" type="submit" disabled="@isSubmitting">Create</button>
        <button class="btn btn-secondary" type="button" @onclick="HideAddForm">Cancel</button>
    </EditForm>
}

@if (isEditVisible && editModel != null)
{
    <h5 class="mt-4">Update job (ID: @editId)</h5>
    <EditForm Model="editModel" OnValidSubmit="UpdateJobAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row mb-2">
            <div class="col-md-4">
                <label>Severity</label>
                <InputNumber @bind-Value="editModel.Severity" class="form-control" min="1" max="10" />
            </div>
            <div class="col-md-4">
                <label>Status</label>
                <InputSelect @bind-Value="editModel.Status" class="form-select">
                    @foreach (var s in GetAllowedStatusOptions(currentStatus))
                    {
                        <option value="@s">@s</option>
                    }
                </InputSelect>
                <div class="form-text">Can only be moved forward: Recorded → In progress → Completed</div>
            </div>
        </div>

        <button class="btn btn-primary me-2" type="submit" disabled="@isSubmitting">Save</button>
        <button class="btn btn-secondary" type="button" @onclick="HideEditForm">Cancel</button>
    </EditForm>
}

@code {
    private List<JobDTO>? jobs;
    private List<ClientDTO>? clients;
    private bool isLoading = true;
    private bool isSubmitting = false;

    private int selectedClientId = 0;
    private bool isAddVisible = false;
    private bool isEditVisible = false;

    private CreateJobDTO createModel = new() { Status = JobStatusEnum.Accepted, ManufacturingYear = DateTime.Now.Year };
    private UpdateJobDTO? editModel;
    private int editId = 0;
    private JobStatusEnum currentStatus;

    protected override async Task OnInitializedAsync()
    {
        await LoadClientsAsync();
        await LoadJobsAsync();
    }

    private async Task LoadClientsAsync()
    {
        try
        {
            clients = (await ClientsService.GetAllAsync())?.ToList() ?? new();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error during loading clients: {ex.Message}");
        }
    }

    private async Task LoadJobsAsync()
    {
        try
        {
            isLoading = true;
            IEnumerable<JobDTO>? result;

            if (selectedClientId > 0)
                result = await JobsService.GetAllByClientIdAsync(selectedClientId);
            else
                result = await JobsService.GetAllAsync();

            jobs = result?.ToList() ?? new();
            foreach (var job in jobs) {
                Console.WriteLine(job.Id);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error during loading jobs: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ClientFilterChanged(ChangeEventArgs e)
    {
        await LoadJobsAsync();
    }

    private void ShowAddForm() => isAddVisible = true;
    private void HideAddForm() => isAddVisible = false;
    private void HideEditForm() { isEditVisible = false; editModel = null; }

    private async Task CreateJobAsync()
    {
        if (createModel.ManufacturingYear < 1900)
        {
            await JS.InvokeVoidAsync("alert", "The year of manufacture must not be earlier than 1900.");
            return;
        }

        try
        {
            isSubmitting = true;
            if (await JobsService.CreateAsync(createModel))
            {
                await LoadJobsAsync();
                isAddVisible = false;
            }
            else
                await JS.InvokeVoidAsync("alert", "Error during creating job.");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally { isSubmitting = false; }
    }

    private void OpenEdit(JobDTO job)
    {
        editId = job.Id;
        currentStatus = job.Status;
        editModel = new UpdateJobDTO
        {
            Severity = job.Severity,
            Status = job.Status
        };
        isEditVisible = true;
    }

    private async Task UpdateJobAsync()
    {
        if (editModel is null) return;

        if (editModel.ManufacturingYear.HasValue && editModel.ManufacturingYear.Value < 1900)
        {
            await JS.InvokeVoidAsync("alert", "The year of manufacture must not be earlier than 1900.");
            return;
        }

        var allowed = GetAllowedStatusOptions(currentStatus);
        if (editModel.Status.HasValue && !allowed.Contains(editModel.Status.Value))
        {
            await JS.InvokeVoidAsync("alert", "Status can only be moved forward.");
            return;
        }

        try
        {
            isSubmitting = true;
            if (await JobsService.UpdateAsync(editId, editModel))
            {
                await LoadJobsAsync();
                HideEditForm();
            }
            else
                await JS.InvokeVoidAsync("alert", "Error during refreshing.");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally { isSubmitting = false; }
    }

    private async Task DeleteJobAsync(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete the job with ID {id}?")) return;

        try
        {
            if (await JobsService.DeleteAsync(id))
                await LoadJobsAsync();
            else
                await JS.InvokeVoidAsync("alert", "Error during deleting.");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
    }

    private IEnumerable<JobStatusEnum> GetAllowedStatusOptions(JobStatusEnum current)
    {
        var list = Enum.GetValues<JobStatusEnum>().Cast<JobStatusEnum>().ToList();
        var idx = list.IndexOf(current);
        return idx < 0 ? list : list.Skip(idx);
    }

    private string GetStatusColor(JobStatusEnum status) => status switch
    {
        JobStatusEnum.Accepted => "info",
        JobStatusEnum.InProgress => "warning",
        JobStatusEnum.Completed => "success",
        _ => "secondary"
    };
}
